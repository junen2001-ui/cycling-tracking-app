{
  "expo": {
    "name": "breakfast-ride-planner",
    "slug": "breakfast-ride-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.breakfastrideplanner.mobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyDisR5nAkxSDBzXlH6Z2FxW488TFxQO8CY"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withAndroidForceDarkDisabled",
      "./plugins/withAndroidForceLightMode",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "出発地点の初期表示に現在地を使用するために使用します。"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1fe7d192-a4cc-47bf-a52c-b51863f5136b"
      }
    },
    "owner": "endy_jun"
  }
}
